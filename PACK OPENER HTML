<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>PokéVault — Ultimate Pack Opener</title>
<style>
:root{--bg:#081126;--panel:#101d3b;--panel2:#172750;--gold:#ffd34e;--cyan:#72e7ff;--muted:#a9b9df;--text:#f6f8ff}*{box-sizing:border-box}body{margin:0;min-height:100vh;font:15px system-ui,-apple-system,Segoe UI,sans-serif;color:var(--text);background:radial-gradient(circle at top,#1a3470 0,#081126 48%,#050a19 100%)}header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px max(18px,calc((100% - 1180px)/2));background:#09132cdd;position:sticky;top:0;z-index:3;backdrop-filter:blur(12px)}.brand{font-size:24px;font-weight:900;color:var(--gold)}.brand span{color:var(--cyan)}.wallet{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.pill,.stat,.panel,.pack-card{background:#101d3bee;border:1px solid #2b4277;border-radius:14px}.pill{padding:9px 13px}.coins{color:var(--gold)}main,.hero,footer{max-width:1180px;margin:auto;padding-left:18px;padding-right:18px}.hero{text-align:center;padding-top:58px;padding-bottom:32px}.hero h1{font-size:clamp(32px,6vw,64px);margin:0;background:linear-gradient(90deg,var(--cyan),var(--gold));color:transparent;background-clip:text}.hero p,.muted{color:var(--muted)}.tabs{display:flex;gap:8px;max-width:1180px;margin:auto;padding:0 18px 20px;overflow:auto}.tabs button,.button{border:0;border-radius:10px;padding:11px 15px;color:var(--text);background:#172750;cursor:pointer;font-weight:700;white-space:nowrap}.tabs button.active,.button.primary{background:linear-gradient(135deg,#2f8fff,#7449ff);box-shadow:0 5px 20px #315cff55}.view{display:none}.view.active{display:block}.statbar{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px}.stat{padding:15px;text-align:center}.stat b{display:block;color:var(--gold);font-size:22px}.stat small{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}.pack-card{padding:14px;overflow:hidden}.pack-art{height:150px;border-radius:11px;display:grid;place-items:center;background:linear-gradient(135deg,var(--pack1),var(--pack2));box-shadow:inset 0 0 40px #0005}.ball{font-size:56px;filter:drop-shadow(0 8px 8px #0007)}.pack-card h3{margin-bottom:4px}.pack-card .price{color:var(--gold);font-weight:800}.pack-card button{width:100%;margin-top:12px}.panel{padding:18px;margin-bottom:16px}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 0 16px}.section-title h2{margin:0}.secondary{background:transparent;color:var(--muted);border:1px solid #52699e;padding:8px 12px;border-radius:9px;cursor:pointer}.collection{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:15px}.slab{background:#d7e2f0;color:#101a34;border:8px solid #8fa8c4;border-radius:12px;padding:8px;box-shadow:0 8px 20px #0005}.slab.rare{border-color:#f4c34b}.slab.ultra{border-color:#ef72ff}.slab.secret{border-color:#55f4d5}.slab-label{display:flex;justify-content:space-between;font-size:10px;font-weight:900}.grade{color:#243d8f}.pokemon-image{height:145px;display:grid;place-items:center;background:linear-gradient(135deg,#dceeff,#fff);margin:7px 0;border-radius:6px}.pokemon-image img{max-width:100%;max-height:140px}.slab h3{margin:4px 0}.catalog{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}.progress{height:8px;background:#07102a;border-radius:9px;overflow:hidden}.progress span{display:block;height:100%;background:var(--cyan)}.message{text-align:center;color:var(--gold);min-height:24px}footer{text-align:center;padding-top:36px;padding-bottom:30px;color:#7184ad;font-size:12px}.cutscene{position:fixed;inset:0;background:#020617dd;display:none;place-items:center;z-index:5;padding:20px}.cutscene.show{display:grid}.cutscene-box{text-align:center;background:linear-gradient(145deg,#192d66,#0c1735);padding:35px;border:2px solid var(--gold);border-radius:22px;max-width:420px;box-shadow:0 0 70px #2d68ff88}.emoji{font-size:70px}.backgrounds{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}.backgrounds button{width:100%;text-align:left}.body-mew{background:radial-gradient(circle,#54146b,#130827 60%)}.body-lugia{background:radial-gradient(circle,#1d6385,#07152b 60%)}.body-rainbow{background:linear-gradient(120deg,#241047,#125761,#6d251d);background-attachment:fixed}@media(max-width:600px){header{align-items:flex-start;flex-direction:column}.wallet{justify-content:flex-start}.statbar{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><div class="brand">⚡ Poké<span>Vault</span></div><div class="wallet"><div class="pill coins">🪙 <b id="coins">250</b> Poké Coins</div><div class="pill">📦 <b id="opened">0</b> opened</div></div></header>
<section class="hero"><h1>The Ultimate Pack Opener</h1><p>Rip packs. Chase hits. Build your vault.</p></section>
<nav class="tabs"><button class="active" data-tab="shop">🛒 Pack Shop</button><button data-tab="vault">🗃️ My Vault</button><button data-tab="sets">📚 Set Archive</button><button data-tab="arenas">🌌 Arenas</button></nav>
<main>
<section id="shop" class="view active"><div class="statbar"><div class="stat"><b id="best">—</b><small>best pull</small></div><div class="stat"><b id="slabCount">0</b><small>cards in vault</small></div><div class="stat"><button class="button primary" id="earn">💵 Earn 10 coins</button></div></div><p id="message" class="message"></p><div id="packGrid" class="grid"></div></section>
<section id="vault" class="view"><div class="section-title"><h2>🏆 Your Graded Vault</h2><button class="secondary" id="clearVault">Reset save</button></div><p class="muted">Your pulls are saved in this browser.</p><div id="collection" class="collection"></div></section>
<section id="sets" class="view"><div class="section-title"><h2>📚 Set Archive</h2></div><div id="catalog" class="catalog"></div></section>
<section id="arenas" class="view"><div class="section-title"><h2>🌌 Unlockable Arenas</h2></div><div id="backgroundGrid" class="backgrounds"></div></section>
</main><footer>Fan-made demo • Pokémon and related marks belong to their respective owners • Artwork from PokéAPI</footer>
<div id="cutscene" class="cutscene"><div class="cutscene-box"><div id="sceneEmoji" class="emoji">✨</div><h2 id="sceneTitle">INCREDIBLE PULL!</h2><p id="sceneText"></p><button class="button primary" id="closeScene">Continue</button></div></div>
<script>
'use strict';
const artwork=id=>`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
const packs=[{name:'Base Set Booster',set:'Base Set',price:25,emoji:'🌿',colors:['#35a56a','#193b93'],pool:[1,4,7,25,133,150]},{name:'Neo Genesis Booster',set:'Neo Genesis',price:40,emoji:'🌙',colors:['#3f4bd8','#10133e'],pool:[152,155,158,175,249]},{name:'EX Era Booster',set:'EX Ruby & Sapphire',price:55,emoji:'💎',colors:['#f04483','#5223a8'],pool:[6,9,3,65,384]},{name:'Hidden Fates Shiny',set:'Hidden Fates',price:75,emoji:'✨',colors:['#f0c63c','#4b1a91'],pool:[25,133,94,212,448]},{name:'Crown Zenith Galarian',set:'Crown Zenith',price:90,emoji:'👑',colors:['#f7f7ff','#6585d7'],pool:[58,59,445,471,487]},{name:'151 Masterball',set:'151',price:120,emoji:'🔴',colors:['#e63946','#79152a'],pool:[1,4,7,25,133,150,151]},{name:'Mega Evolution God Pack',set:'Mega Evolution',price:250,emoji:'⚡',colors:['#ff7b22','#d20c35'],pool:[6,9,3,150,249,384,445]}];
const names={1:['Bulbasaur','🌱','common'],3:['Venusaur','🌿','ultra'],4:['Charmander','🔥','common'],6:['Charizard','🐉','ultra'],7:['Squirtle','💧','common'],9:['Blastoise','🌊','ultra'],25:['Pikachu','⚡','rare'],65:['Alakazam','🔮','rare'],94:['Gengar','👻','rare'],133:['Eevee','🦊','rare'],150:['Mewtwo','🧬','ultra'],151:['Mew','✨','secret'],152:['Chikorita','🍃','common'],155:['Cyndaquil','🔥','common'],158:['Totodile','💧','common'],175:['Togepi','🥚','rare'],197:['Umbreon','🌑','ultra'],212:['Scizor','🦀','rare'],249:['Lugia','🌊','secret'],384:['Rayquaza','🐲','secret'],445:['Garchomp','🦈','ultra'],448:['Lucario','🥊','rare'],471:['Glaceon','❄️','rare'],487:['Giratina','👁️','ultra'],571:['Zoroark','🦊','rare'],887:['Dreepy','👻','common'],888:['Zacian','⚔️','ultra'],889:['Zamazenta','🛡️','ultra']};
const sets=['Base Set','Jungle','Fossil','Team Rocket','Neo Genesis','EX Ruby & Sapphire','Diamond & Pearl','Hidden Fates','Crown Zenith','151','Mega Evolution'];
const $=id=>document.getElementById(id);let state;try{state=JSON.parse(localStorage.getItem('pokeVault'))||null}catch(e){state=null}state=state||{coins:250,opened:0,collection:[],best:'—',background:'default',backgrounds:['default']};function save(){localStorage.setItem('pokeVault',JSON.stringify(state))}function cardFor(id,set){let c=names[id]||['Mystery Pokémon','❔','common'];let rarity=c[2],roll=Math.random();if(roll>.97)rarity='secret';else if(roll>.78&&rarity==='common')rarity='rare';return{id,name:c[0],emoji:c[1],rarity,set,grade:(rarity==='secret'?10:rarity==='ultra'?9.5:rarity==='rare'?9:8+Math.floor(Math.random()*2))}}function renderStats(){$('coins').textContent=state.coins;$('opened').textContent=state.opened;$('best').textContent=state.best;$('slabCount').textContent=state.collection.length}function renderPacks(){$('packGrid').innerHTML=packs.map((p,i)=>`<article class="pack-card"><div class="pack-art" style="--pack1:${p.colors[0]};--pack2:${p.colors[1]}"><div class="ball">${p.emoji}</div></div><h3>${p.name}</h3><p class="muted">${p.set}</p><span class="price">🪙 ${p.price}</span><button class="button primary" data-open="${i}">Open pack</button></article>`).join('');document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>openPack(Number(b.dataset.open)))}function openPack(i){let p=packs[i];if(state.coins<p.price){$('message').textContent='Not enough coins — earn some first!';return}state.coins-=p.price;state.opened++;let pulls=Array.from({length:5},()=>cardFor(p.pool[Math.floor(Math.random()*p.pool.length)],p.set));state.collection.unshift(...pulls);let best=pulls.slice().sort((a,b)=>b.grade-a.grade)[0];if(best.grade>(state.collection.find(c=>c.name===state.best)?.grade||0))state.best=best.name;unlock(p.set);save();renderAll();let hit=pulls.find(c=>c.rarity==='secret'||c.rarity==='ultra')||best;$('sceneEmoji').textContent=hit.emoji;$('sceneTitle').textContent=hit.rarity==='secret'?'🌈 SECRET RARE!':'⚡ PACK OPENED!';$('sceneText').textContent=`${hit.name} • ${hit.set} • Grade ${hit.grade}`;$('cutscene').classList.add('show')}function unlock(set){let map={'151':'mew','Crown Zenith':'lugia','Hidden Fates':'rainbow'};if(map[set]&&!state.backgrounds.includes(map[set]))state.backgrounds.push(map[set])}function slab(c){return`<article class="slab ${c.rarity}"><div class="slab-label"><span>POKÉVAULT AUTHENTIC</span><span class="grade">GRADE ${c.grade}</span></div><div class="pokemon-image"><img src="${artwork(c.id)}" alt="${c.name}" onerror="this.style.display='none'"></div><h3>${c.emoji} ${c.name}</h3><small>${c.set} • ${c.rarity}</small></article>`}function renderVault(){$('collection').innerHTML=state.collection.length?state.collection.map(slab).join(''):'<div class="panel"><h3>Your vault is empty.</h3><p class="muted">Open a pack to create your collection.</p></div>'}function renderCatalog(){$('catalog').innerHTML=sets.map(s=>`<article class="panel"><h3>${s}</h3><p class="muted">Classic and modern Pokémon cards</p><div class="progress"><span style="width:${Math.min(100,state.collection.filter(c=>c.set===s).length*12)}%"></span></div></article>`).join('')}function renderBackgrounds(){let b=[['default','🌌','Midnight Vault'],['mew','✨','Mew’s Cosmos'],['lugia','🌊','Lugia’s Deep'],['rainbow','🌈','Rainbow Prism']];$('backgroundGrid').innerHTML=b.map(x=>`<button class="button ${state.background===x[0]?'primary':''}" data-bg="${x[0]}">${x[1]} ${x[2]} ${state.backgrounds.includes(x[0])?'✓':'🔒'}</button>`).join('');document.querySelectorAll('[data-bg]').forEach(btn=>btn.onclick=()=>{if(!state.backgrounds.includes(btn.dataset.bg))return;state.background=btn.dataset.bg;document.body.className=btn.dataset.bg==='default'?'':'body-'+btn.dataset.bg;save();renderBackgrounds()})}function renderAll(){renderStats();renderPacks();renderVault();renderCatalog();renderBackgrounds()}document.querySelectorAll('[data-tab]').forEach(btn=>btn.onclick=()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));btn.classList.add('active');document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));$(btn.dataset.tab).classList.add('active')});$('earn').onclick=()=>{state.coins+=10;save();$('message').textContent='💵 +10 Poké Coins added!';renderStats()};$('closeScene').onclick=()=>$('cutscene').classList.remove('show');$('clearVault').onclick=()=>{if(confirm('Reset your saved collection and coins?')){localStorage.removeItem('pokeVault');location.reload()}};document.body.className=state.background==='default'?'':'body-'+state.background;renderAll();
</script>
</body>
</html>
