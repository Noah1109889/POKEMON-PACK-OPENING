<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PokéVault — Ultimate Pack Opener</title>
<style>
:root{--bg:#081126;--panel:#101d3b;--panel2:#172750;--gold:#ffd34e;--cyan:#72e7ff;--muted:#a9b9df;--text:#f6f8ff}*{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:Inter,system-ui,Arial;color:var(--text);background:radial-gradient(circle at 15% 5%,#243e83 0,transparent 30%),radial-gradient(circle at 90% 10%,#501d75 0,transparent 28%),linear-gradient(135deg,var(--bg),#050711);overflow-x:hidden}body.mew{background:radial-gradient(circle at 50% 0,#9b5de5 0,transparent 35%),linear-gradient(135deg,#181044,#07132b)}body.charizard{background:radial-gradient(circle at 50% 0,#ee6b32 0,transparent 32%),linear-gradient(135deg,#3c1020,#090b16)}body.lugia{background:radial-gradient(circle at 50% 0,#56c7e8 0,transparent 34%),linear-gradient(135deg,#082e4a,#081126)}body.rainbow{background:linear-gradient(135deg,#ec4899,#7c3aed,#06b6d4,#16a34a);background-size:300% 300%;animation:rainbow 8s ease infinite}@keyframes rainbow{50%{background-position:100% 70%}}header{padding:22px 5vw 8px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.brand{font-size:clamp(1.6rem,4vw,2.7rem);font-weight:950;letter-spacing:-2px;text-shadow:0 0 22px #ffd34e}.brand span{color:var(--gold)}.wallet{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.pill{background:#0a1430cc;border:1px solid #ffffff25;border-radius:999px;padding:10px 16px;font-weight:800;box-shadow:0 8px 24px #0004}.coins{color:var(--gold)}button,select{border:0;border-radius:12px;padding:12px 17px;font:inherit;font-weight:850;cursor:pointer;color:#101525;background:var(--gold);box-shadow:0 4px 0 #ad7b00;transition:.18s}button:hover{filter:brightness(1.12);transform:translateY(-2px)}button:active{transform:translateY(2px);box-shadow:0 1px 0 #ad7b00}button.secondary{background:#a9b9df;box-shadow:0 4px 0 #65749e}button:disabled{opacity:.5;cursor:not-allowed;transform:none}.hero{text-align:center;padding:22px 15px 12px}.hero h1{font-size:clamp(2rem,6vw,4.8rem);margin:10px 0 0;letter-spacing:-3px}.hero p{color:var(--muted);font-size:1.08rem}.tabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;padding:8px 15px 20px}.tabs button{background:#182956;color:#dce7ff;box-shadow:none}.tabs button.active{background:var(--gold);color:#111}.view{display:none;max-width:1250px;margin:auto;padding:0 18px 50px}.view.active{display:block}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.section-title h2{margin:14px 0}.pack-grid,.catalog,.collection,.backgrounds{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}.pack-card,.panel{background:linear-gradient(145deg,#172750e8,#0d1833e8);border:1px solid #ffffff18;border-radius:20px;padding:18px;box-shadow:0 14px 35px #0004}.pack-art{height:185px;border-radius:15px;display:grid;place-items:center;text-align:center;padding:15px;background:linear-gradient(145deg,var(--pack1),var(--pack2));border:3px solid #ffffff80;box-shadow:inset 0 0 35px #fff3,0 8px 18px #0005}.pack-art .ball{font-size:4.5rem;filter:drop-shadow(0 5px 5px #0008)}.pack-card h3{margin:12px 0 4px}.muted{color:var(--muted);font-size:.9rem}.price{color:var(--gold);font-size:1.15rem;font-weight:900;margin:11px 0}.card-list{display:flex;flex-wrap:wrap;gap:5px;font-size:.75rem;color:#d5e2ff}.collection{margin-top:10px}.slab{background:#dce8f2;border:7px solid #b8cfe0;border-radius:13px;padding:7px;color:#13213d;box-shadow:0 9px 19px #0007;position:relative}.slab.rare{border-color:#55adff;box-shadow:0 0 22px #55adff99}.slab.ultra{border-color:#ffd429;box-shadow:0 0 28px #ffd429cc}.slab.secret{border-color:#ff65da;box-shadow:0 0 32px #ff65da}.slab-label{background:#203b68;color:#fff;border-radius:5px;padding:5px;font-size:.72rem;font-weight:900;display:flex;justify-content:space-between}.grade{color:#ffd34e}.pokemon-image{height:145px;display:grid;place-items:center;background:radial-gradient(circle,#dbf5ff,#6a91ba);margin:7px 0;border:3px solid #52647e;border-radius:5px}.pokemon-image img{width:100%;height:100%;object-fit:contain}.slab h3{margin:5px 0 2px}.slab p{margin:3px 0;font-size:.8rem;font-weight:750}.tag{display:inline-block;padding:3px 7px;border-radius:20px;background:#172750;color:#fff;font-size:.7rem}.statbar{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:4px 0 24px}.stat{padding:13px;border-radius:15px;background:#0d1935;border:1px solid #ffffff14;text-align:center}.stat b{display:block;font-size:1.35rem;color:var(--gold)}.stat small{color:var(--muted)}.backgrounds .panel{min-height:145px}.locked{filter:grayscale(1);opacity:.6}.progress{height:8px;border-radius:20px;background:#060b1c;overflow:hidden;margin:10px 0}.progress span{display:block;height:100%;background:var(--gold)}#message{text-align:center;min-height:35px;color:var(--gold);font-weight:900;font-size:1.2rem;margin:10px}.flash{position:fixed;inset:0;z-index:5;pointer-events:none;background:radial-gradient(circle,#fff,#ffd34e99,transparent 60%);animation:flash .9s forwards}@keyframes flash{0%{opacity:0}20%{opacity:1}100%{opacity:0}}.cutscene{position:fixed;inset:0;z-index:4;display:none;place-items:center;background:#050713dd;backdrop-filter:blur(8px)}.cutscene.show{display:grid}.cutscene-box{text-align:center;animation:zoom .8s both}.cutscene-box .emoji{font-size:8rem;filter:drop-shadow(0 0 30px var(--gold));animation:spin 1.4s infinite alternate}@keyframes zoom{from{transform:scale(.2) rotate(-12deg);opacity:0}to{transform:scale(1);opacity:1}}@keyframes spin{to{transform:scale(1.15) rotate(7deg)}}.spark{position:fixed;z-index:6;pointer-events:none;font-size:2rem;animation:fall 1.6s linear forwards}@keyframes fall{to{transform:translateY(100vh) rotate(720deg);opacity:0}}footer{text-align:center;color:#8294bd;padding:12px 20px 30px;font-size:.8rem}
</style>
</head>
<body>
<header><div class="brand">⚡ Poké<span>Vault</span></div><div class="wallet"><div class="pill coins">🪙 <span id="coins">250</span> Poké Coins</div><div class="pill">📦 <span id="opened">0</span> packs</div><button id="earn">💵 Get $1 / +10 coins</button></div></header>
<section class="hero"><h1>The Ultimate Pack Opener</h1><p>Rip packs. Chase hits. Slab every pull. Build the vault.</p></section>
<nav class="tabs"><button class="active" data-tab="shop">🛒 Pack Shop</button><button data-tab="vault">🗃️ My Vault</button><button data-tab="sets">📚 Set Archive</button><button data-tab="backgrounds">🌌 Backgrounds</button></nav>
<main>
<section id="shop" class="view active"><div class="statbar"><div class="stat"><b id="best">—</b><small>best pull</small></div><div class="stat"><b id="slabCount">0</b><small>slabbed cards</small></div><div class="stat"><b id="ultraCount">0</b><small>ultra hits</small></div><div class="stat"><b>1999–NOW</b><small>era coverage</small></div></div><div class="section-title"><h2>Choose your pack</h2><span class="muted">Every pull is automatically graded and sealed.</span></div><div id="packGrid" class="pack-grid"></div><div id="message"></div></section>
<section id="vault" class="view"><div class="section-title"><h2>🏆 Your Graded Vault</h2><button class="secondary" id="clearVault">Reset save</button></div><p class="muted">Cards are simulated collectibles. Each slab gets a randomized PSA-style grade based on rarity.</p><div id="collection" class="collection"></div></section>
<section id="sets" class="view"><div class="section-title"><h2>📚 Set Archive</h2><span class="muted">A growing catalog of classic and modern eras</span></div><div id="catalog" class="catalog"></div></section>
<section id="backgrounds" class="view"><div class="section-title"><h2>🌌 Unlockable Arenas</h2><span class="muted">Pull themed cards to unlock their worlds.</span></div><div id="backgroundGrid" class="backgrounds"></div></section>
</main><footer>Fan-made demo • Pokémon and related marks belong to their respective owners • Artwork from PokéAPI</footer>
<div id="cutscene" class="cutscene"><div class="cutscene-box"><div id="sceneEmoji" class="emoji">✨</div><h2 id="sceneTitle">INCREDIBLE PULL!</h2><p id="sceneText"></p><button id="closeScene">Add to vault</button></div></div>
<script>
const artwork=id=>`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
const sets=[
['Base Set','1999','Vintage'],['Jungle','1999','Vintage'],['Fossil','1999','Vintage'],['Team Rocket','2000','Vintage'],['Neo Genesis','2000','Neo'],['EX Ruby & Sapphire','2003','EX'],['Diamond & Pearl','2007','DP'],['HeartGold SoulSilver','2010','HGSS'],['Black & White','2011','BW'],['XY','2014','XY'],['Sun & Moon','2017','SM'],['Hidden Fates','2019','Special'],['Sword & Shield','2020','SWSH'],['Celebrations','2021','Special'],['Crown Zenith','2023','Special'],['Scarlet & Violet','2023','SV'],['151','2023','Special'],['Paldean Fates','2024','Special'],['Twilight Masquerade','2024','SV'],['Mega Evolution','2025','Modern']
];
const packs=[
{name:'Base Set Booster',set:'Base Set',price:25,emoji:'🌿',colors:['#35a56a','#193b93'],pool:[1,4,7,25,133,150],desc:'The legendary beginning.'},
{name:'Neo Genesis Booster',set:'Neo Genesis',price:40,emoji:'🌙',colors:['#3f4bd8','#10133e'],pool:[152,155,158,175,249],desc:'Ancient powers awaken.'},
{name:'EX Era Booster',set:'EX Ruby & Sapphire',price:55,emoji:'💎',colors:['#f04483','#5223a8'],pool:[6,9,3,65,384],desc:'Holo energy overload.'},
{name:'Hidden Fates Shiny',set:'Hidden Fates',price:75,emoji:'✨',colors:['#f0c63c','#4b1a91'],pool:[25,133,94,212,448],desc:'Shiny hunting activated.'},
{name:'Crown Zenith Galarian',set:'Crown Zenith',price:90,emoji:'👑',colors:['#f7f7ff','#6585d7'],pool:[58,59,445,471,487],desc:'A gallery full of stars.'},
{name:'151 Masterball',set:'151',price:120,emoji:'🔴',colors:['#e63946','#79152a'],pool:[1,4,7,25,133,150,151],desc:'Catch the original 151.'},
{name:'SV Twilight Masquerade',set:'Twilight Masquerade',price:140,emoji:'🎭',colors:['#19b7a7','#28104f'],pool:[887,888,889,197,197,571],desc:'Terastal spectacle.'},
{name:'Mega Evolution God Pack',set:'Mega Evolution',price:250,emoji:'⚡',colors:['#ff7b22','#d20c35'],pool:[6,9,3,150,249,384,445],desc:'The jackpot chase.'}
];
const cards={1:['Bulbasaur','🌱','common'],4:['Charmander','🔥','common'],7:['Squirtle','💧','common'],25:['Pikachu','⚡','rare'],133:['Eevee','🦊','rare'],150:['Mewtwo','🧬','ultra'],151:['Mew','✨','secret'],152:['Chikorita','🍃','common'],155:['Cyndaquil','🔥','common'],158:['Totodile','💦','common'],175:['Togepi','🥚','rare'],249:['Lugia','🌊','ultra'],3:['Venusaur ex','🌺','ultra'],6:['Charizard ex','🐉','ultra'],9:['Blastoise ex','💧','ultra'],65:['Alakazam ex','🔮','rare'],384:['Rayquaza','🐲','secret'],94:['Gengar','👻','rare'],212:['Scizor','🪲','rare'],448:['Lucario','🥊','rare'],58:['Growlithe','🔥','common'],59:['Arcanine','🔥','rare'],445:['Garchomp','🐉','ultra'],471:['Glaceon','❄️','ultra'],487:['Giratina','🌀','secret'],887:['Dreepy','👻','common'],888:['Drakloak','👻','rare'],889:['Dragapult ex','🚀','ultra'],197:['Umbreon','🌑','secret'],571:['Zoroark','🦊','rare']};
let state=JSON.parse(localStorage.pokeVault||'null')||{coins:250,opened:0,collection:[],best:'—',background:'default'};const $=id=>document.getElementById(id);function save(){localStorage.pokeVault=JSON.stringify(state);renderStats()};function renderStats(){$('coins').textContent=state.coins.toLocaleString();$('opened').textContent=state.opened;$('slabCount').textContent=state.collection.length;$('ultraCount').textContent=state.collection.filter(c=>['ultra','secret'].includes(c.rarity)).length;$('best').textContent=state.best}
function cardFor(id,set){let c=cards[id]||['Mystery Pokémon','❔','common'];let r=c[2];let roll=Math.random();if(roll>.96)r='secret';else if(roll>.79&&r==='common')r='rare';return{id,name:c[0],emoji:c[1],rarity:r,set,grade:(r==='secret'?10: r==='ultra'?Math.random()>.3?10:9:Math.random()>.65?9:8+Math.floor(Math.random()*2))}}
function slab(c){return `<article class="slab ${c.rarity}"><div class="slab-label"><span>POKÉVAULT AUTHENTIC</span><span class="grade">GRADE ${c.grade}</span></div><div class="pokemon-image"><img src="${artwork(c.id)}" alt="${c.name}" onerror="this.style.display='none';this.parentNode.textContent='${c.emoji}'"></div><h3>${c.name}</h3><p>${c.emoji} ${c.rarity.toUpperCase()} <span class="tag">${c.set}</span></p><p>Certified pull • #${String(c.id).padStart(3,'0')}</p></article>`}
function renderPacks(){$('packGrid').innerHTML=packs.map((p,i)=>`<article class="pack-card"><div class="pack-art" style="--pack1:${p.colors[0]};--pack2:${p.colors[1]}"><div><div class="ball">${p.emoji}</div><b>${p.set.toUpperCase()}</b></div></div><h3>${p.name}</h3><div class="muted">${p.desc} • 5 cards</div><div class="price">🪙 ${p.price} Poké Coins</div><button onclick="openPack(${i})" ${state.coins<p.price?'disabled':''}>Rip this pack</button></article>`).join('')}
function sparks(){for(let i=0;i<30;i++){let s=document.createElement('div');s.className='spark';s.textContent=['✨','⚡','⭐','💥'][Math.floor(Math.random()*4)];s.style.left=Math.random()*100+'vw';s.style.top=Math.random()*30+'vh';s.style.animationDelay=Math.random()*.6+'s';document.body.appendChild(s);setTimeout(()=>s.remove(),2200)}}
function openPack(i){let p=packs[i];if(state.coins<p.price)return;state.coins-=p.price;state.opened++;let pulls=Array.from({length:5},(_,n)=>cardFor(p.pool[Math.floor(Math.random()*p.pool.length)],p.set));let best=pulls.reduce((a,b)=>({secret:4,ultra:3,rare:2,common:1}[b.rarity]>{secret:4,ultra:3,rare:2,common:1}[a.rarity]?b:a));state.collection.unshift(...pulls);if(['ultra','secret'].includes(best.rarity)){state.best=best.name;showScene(best)}else{$('message').textContent=`Pack opened! Best pull: ${best.name} (${best.rarity})`;};if(['151','Crown Zenith','Hidden Fates'].includes(p.set))unlock(p.set);save();renderPacks();renderVault();sparks()}
function showScene(c){$('sceneEmoji').textContent=c.emoji;$('sceneTitle').textContent=c.rarity==='secret'?'🌈 SECRET RARE!':'⚡ ULTRA RARE HIT!';$('sceneText').textContent=`${c.name} • ${c.set} • Grade ${c.grade} has entered the vault!`;$('cutscene').classList.add('show');sparks()}
function unlock(name){let map={'151':'mew','Crown Zenith':'lugia','Hidden Fates':'rainbow'};if(map[name]&&!state.backgrounds?.includes(map[name])){state.backgrounds=[...(state.backgrounds||[]),map[name]];$('message').textContent=`🌌 New background unlocked: ${name}!`}}
function renderVault(){$('collection').innerHTML=state.collection.length?state.collection.map(slab).join(''):'<div class="panel"><h3>Your vault is empty.</h3><p class="muted">Open a pack to create your first graded slab.</p></div>'}
function renderCatalog(){$('catalog').innerHTML=sets.map(s=>`<article class="panel"><h3>${s[0]}</h3><p class="muted">${s[1]} • ${s[2]} era</p><div class="progress"><span style="width:${Math.min(100,5+state.collection.filter(c=>c.set===s[0]).length*12)}%"></span></div><small>${state.collection.filter(c=>c.set===s[0]).length} slabbed pulls</small></article>`).join('')}
function renderBackgrounds(){let b=[['default','🌌','Midnight Vault','Always unlocked'],['mew','✨','Mew’s Cosmos','Pull a 151 pack'],['lugia','🌊','Lugia’s Deep','Pull a Crown Zenith pack'],['rainbow','🌈','Shiny Rainbow','Pull a Hidden Fates pack']];$('backgroundGrid').innerHTML=b.map(x=>{let ok=x[0]==='default'||state.backgrounds?.includes(x[0]);return `<article class="panel ${ok?'':'locked'}"><h3>${x[1]} ${x[2]}</h3><p class="muted">${ok?'Unlocked':x[3]}</p><button ${ok?'':'disabled'} onclick="document.body.className='${x[0]}';state.background='${x[0]}';save()">${state.background===x[0]?'Equipped':'Equip'}</button></article>`}).join('')}
$('earn').onclick=()=>{state.coins+=10;save();$('message').textContent='💵 Cha-ching! +$1 added as 10 Poké Coins.';renderPacks()};$('closeScene').onclick=()=>{$('cutscene').classList.remove('show');renderVault()};$('clearVault').onclick=()=>{if(confirm('Reset all local save data?')){localStorage.removeItem('pokeVault');location.reload()}};document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.tab).classList.add('active');if(b.dataset.tab==='vault')renderVault();if(b.dataset.tab==='sets')renderCatalog();if(b.dataset.tab==='backgrounds')renderBackgrounds()});
renderStats();renderPacks();renderVault();renderCatalog();renderBackgrounds();if(state.background&&state.background!=='default')document.body.className=state.background;
</script></body></html>
